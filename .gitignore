# ==========================================
# Byte-compiled / Python Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Virtuelle Umgebungen (Virtual Environments)
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# IDEs & Editor-Dateien
# ==========================================
# PyCharm
.idea/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==========================================
# Jupyter Notebooks & Data Science Cache
# ==========================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==========================================
# Daten & große Dateien (Optional anpassen)
# ==========================================
# Schützt davor, große Datensätze versehentlich hochzuladen
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle

# Ausnahmen für Beispieldaten erlauben (falls nötig):
# !Data/sample.csv

# ==========================================
# Umgebungs-Variablen & Zugangsdaten
# ==========================================
.env
.env.local
*.secret

# ==========================================
# Distribution / Packaging
# ==========================================
build/
devel/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Tests & Coverage
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.nox/
.tox/